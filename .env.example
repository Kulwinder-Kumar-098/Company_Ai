DATABASE_URL=postgresql+psycopg://user:password@localhost/company_ai
LLM_MODEL=llama3.2:3b

# The planner defaults to Ollama. PLANNER_MODEL falls back to LLM_MODEL.
PLANNER_PROVIDER=ollama
PLANNER_MODEL=
GROQ_API_KEY=

# To use Groq for planning only, set:
# PLANNER_PROVIDER=groq
# PLANNER_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=your-groq-api-key
