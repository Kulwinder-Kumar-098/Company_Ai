APP_ENV=development
DATABASE_URL=postgresql+psycopg://company_app:change-me@localhost:5432/company_ai
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
COMPANY_AI_API_URL=http://localhost:8000
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text:latest
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=data/documents
VECTOR_STORE_BACKEND=faiss
DOCUMENT_FAISS_INDEX_PATH=data/indexes/documents.faiss

# Production: use durable S3-compatible storage, such as Cloudflare R2.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=company-ai-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
#
# Production: use Qdrant Cloud for the durable document vector index.
# VECTOR_STORE_BACKEND=qdrant
# QDRANT_URL=https://<cluster>.cloud.qdrant.io
# QDRANT_API_KEY=
# QDRANT_COLLECTION=company-ai-document-chunks

# The planner defaults to Ollama. PLANNER_MODEL falls back to LLM_MODEL.
PLANNER_PROVIDER=ollama
PLANNER_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=gemini-3.8-flash
PLANNER_FAST_PATH_ENABLED=true
SMALLTALK_ENABLED=true
SMALLTALK_LLM_FALLBACK_ENABLED=true
SMALLTALK_LLM_TIMEOUT_SECONDS=20
SMALLTALK_MAX_QUERY_CHARACTERS=200
SMALLTALK_MAX_ANSWER_CHARACTERS=600
PLANNER_CACHE_ENABLED=true
PLANNER_CACHE_TTL_SECONDS=21600
PLANNER_CACHE_MAX_ENTRIES=512
PLANNER_RATE_LIMIT_COOLDOWN_ENABLED=true
PLANNER_RATE_LIMIT_COOLDOWN_SECONDS=30
PLANNER_TOKEN_USAGE_LOGGING_ENABLED=true
CHAT_RAG_TOP_K=4
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
RAG_MAX_ANSWER_TOKENS=600

# To use Groq for planning with Gemini as a fallback, set:
# PLANNER_PROVIDER=groq
# PLANNER_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=your-groq-api-key
# GEMINI_API_KEY=your-gemini-api-key
QDRANT_URL=your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key